# Salin file ini menjadi .env.local lalu isi dari Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Hanya untuk `npm run seed` (membuat user dummy). Rahasia — jangan diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
